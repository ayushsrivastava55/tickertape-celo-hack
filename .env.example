# REQUIRED — the Celo address that receives tool payments.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Facilitator API base.
# NOTE: docs.celo.org says https://x402.celo.org, but that host serves the
# marketing site and returns HTML for /supported. The JSON API is on api.*.
FACILITATOR_URL=https://api.x402.celo.org

# Celo RPC. Forno is public and needs no key.
CELO_RPC_URL=https://forno.celo.org

PORT=3000

# Public URL of this server. MUST match the URL buyers actually call, because
# payment requirements bind the signed authorization to the resource URL.
# Set this to your tunnel/deploy URL once it is not localhost.
PUBLIC_BASE_URL=http://localhost:3000

# How long a signed payment authorization stays valid, in seconds.
MAX_TIMEOUT_SECONDS=120

# ---- buyer script only (scripts/buyer.ts) ----
# Throwaway key funded with a small amount of USDC on Celo. Never a real key.
BUYER_PRIVATE_KEY=
SERVER_URL=http://localhost:3000
